{
  "name": "travelx-special-fare-manager",
  "version": "1.0.0",
  "description": "Smart Manual Input + Automatic Fare Comparison System for Travelx",
  "main": "server/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node --max-old-space-size=400 server/index.js",
    "build": "node -e \"console.log('Using pre-built client dist')\"",
    "build:local": "cd client && npm install && npm run build",
    "dev:client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "test": "node tests/backend.test.js",
    "backup:db": "node scripts/backup-database.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop travelx-backend travelx-frontend"
  },
  "keywords": [
    "travelx",
    "airline-fares",
    "b2b-comparison",
    "whatsapp-broadcast"
  ],
  "author": "Google DeepMind / Travelx",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "multer": "^2.4.0",
    "xlsx": "^0.18.5"
  }
}
